{
  "version": "0.1.7",
  "name": "英文区域与字体探测限制",
  "content_scripts": [
    {
      "all_frames": true,
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "*://*.challenges.cloudflare.com/*"
      ],
      "match_about_blank": true,
      "js": [
        "fingerprint.js",
        "patch.js",
        "fontfamily.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "description": "英文区域、字体探测限制与固定 Canvas 读回指纹；保留系统字体、时区、UA、WebRTC 和登录资料。",
  "manifest_version": 3,
  "permissions": [
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "language_headers",
        "path": "language-headers.json",
        "enabled": true
      }
    ]
  }
}
